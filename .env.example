# Power Platform environment settings
# Copy this file to .env and fill in your values.
# Never commit the .env file – it is listed in .gitignore.

# Power Platform environment URL
# Example: https://yourorg.crm4.dynamics.com/
PP_ENVIRONMENT_URL=

# Azure AD Application (client) ID of the service principal used by PAC CLI and GitHub Actions deployment
PP_APP_ID=

# Client secret of the service principal
PP_CLIENT_SECRET=

# Azure AD Tenant ID
PP_TENANT_ID=

# Application (client) ID of the Entra app registration used by the Campanula Planner Graph custom connector
# for delegated Microsoft Graph OAuth. This is a separate app from PP_APP_ID.
# Required: delegated Graph permission Tasks.ReadWrite.
# Example: 00000000-0000-0000-0000-000000000000
PP_CONNECTOR_APP_ID=

# Existing Microsoft Forms connection resource ID used by the solution Flow.
PP_FORMS_CONNECTION_ID=

# Existing Excel Online Business connection resource ID used by the solution Flow.
PP_EXCEL_CONNECTION_ID=

# Existing Planner connection resource ID used by the solution Flow.
PP_PLANNER_CONNECTION_ID=

# Existing Campanula Planner Graph connection resource ID used by the solution Flow.
# Create and authenticate the connection in the target Power Platform environment first,
# then copy its Connection ID GUID. GitHub Actions reads the repository variable
# vars.PP_GRAPH_CONNECTION_ID; it does not read this local .env file.
PP_GRAPH_CONNECTION_ID=

# Existing Office 365 Outlook connection resource ID used by the solution Flow.
PP_OUTLOOK_CONNECTION_ID=
